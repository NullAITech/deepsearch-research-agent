[Desktop Entry]
Version=1.0
Type=Application
Name=DeepSearch Research Studio
GenericName=Autonomous Multi-Source Research Workstation
Comment=Autonomous Multi-Source Research Agent, Grounded Citation Graph & Fact Corroborator
Exec=/usr/local/bin/deepsearch desktop
Icon=/media/neo/f2fdda77-178b-4603-ae80-c7aa4cd97908/zoth-micro-repos/deepsearch-research-agent/assets/icon.png
Terminal=false
Categories=Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open DeepSearch CLI
Exec=x-terminal-emulator -e "/usr/local/bin/deepsearch --help"

[Desktop Action Web]
Name=Open Web UI (Port 8084)
Exec=/usr/local/bin/deepsearch web
